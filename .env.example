# Copy to .env and fill in. .env is gitignored — never commit it.
# docker-compose reads this file automatically.

# --- AI feature (RAG answer synthesis) ---
# Get a key at https://console.anthropic.com/settings/keys
# Without it the app still runs and returns retrieved mission passages.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Paths (defaults are fine locally; docker-compose overrides these) ---
# DATA_DIR=./backend/data
# INDEX_DIR=./backend/index

# --- GCP deploy (only needed for deploy/terraform + deploy/k8s) ---
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# GCS_BUCKET_NAME=
